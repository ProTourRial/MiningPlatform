# MiningPlatform
# Author: Abia Nugrahanto
# Copyright (c) 2026 Abia Nugrahanto. All rights reserved.

# Copy to .env for local Docker development. Replace every change-me value.
NODE_ENV=development
APP_NAME=MiningPlatform
APP_URL=http://localhost
# API is behind exactly one Nginx reverse proxy in docker-compose.yml.
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
ENABLE_SWAGGER=true

# PostgreSQL
POSTGRES_DB=mining_platform
POSTGRES_USER=mining
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql://mining:change-me-postgres@postgres:5432/mining_platform?schema=public

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379
EVENT_BUS_DRIVER=redis
EVENT_STORE_DRIVER=postgres
EVENT_STREAM=mining:domain-events
MINING_EVENT_GROUP=mining-projection-v1
ACCOUNTING_EVENT_GROUP=accounting-worker-v1
REALTIME_EVENT_GROUP=api-realtime-v1
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LOCK_TIMEOUT_MS=60000

# Development dashboard. It is forcibly disabled when NODE_ENV=production.
ENABLE_DEVELOPMENT_DASHBOARD=true
DEVELOPMENT_DASHBOARD_TOKEN=local-development-dashboard
DEVELOPMENT_WORKER_ID=dev-7d9a4df2e77952c0657de069
NEXT_PUBLIC_ENABLE_DEVELOPMENT_DASHBOARD=true
NEXT_PUBLIC_DEVELOPMENT_DASHBOARD_TOKEN=local-development-dashboard
NEXT_PUBLIC_DEVELOPMENT_WORKER_ID=dev-7d9a4df2e77952c0657de069

# Control Plane authentication. Replace every secret before deployment.
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes-never-commit-this
# 32-byte base64url value. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
AUTH_IP_HASH_KEY=replace-with-a-random-hmac-key-at-least-32-characters
AUTH_TOKEN_ISSUER=mining-platform
AUTH_TOKEN_AUDIENCE=mining-platform-control-plane
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_SECURE_COOKIES=false
AUTH_EXPOSE_TEST_TOKENS=true
ENABLE_REALTIME_GATEWAY=true
# Browser endpoints for direct pnpm dev. Docker production overrides these at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Mining gateway
MINING_ASSET=BTC
MINING_ALGORITHM=SHA256
REWARD_METHOD=FOLLOW_UPSTREAM
PLATFORM_FEE_PERCENT=0.5
STRATUM_HOST=0.0.0.0
STRATUM_PORT=3333
# Keep loopback for local validation. Set 0.0.0.0 only behind firewall/DDoS controls.
STRATUM_PUBLISH_ADDRESS=127.0.0.1
STRATUM_PUBLIC_PORT=3333
STRATUM_DEV_MODE=true
STRATUM_DEV_WORKER=demo.worker1
STRATUM_DEV_PASSWORD=x
STRATUM_DEV_DIFFICULTY=0.000001
# Use development only with STRATUM_DEV_MODE=true. Production requires postgres.
STRATUM_AUTH_DRIVER=development
STRATUM_AUTH_MAX_FAILURES=5
STRATUM_AUTH_WINDOW_MS=60000
STRATUM_AUTH_LOCK_MS=900000
STRATUM_VERSION_ROLLING_MASK=1fffe000
STRATUM_SOCKET_TIMEOUT_MS=120000
STRATUM_MAX_LINE_BYTES=16384
STRATUM_MAX_SUBMISSIONS_PER_SECOND=20
STRATUM_DEV_DATA_DIR=/app/data/stratum
STRATUM_IP_HASH_KEY=replace-with-a-random-hmac-key-at-least-32-characters
SEED_DEVELOPMENT_DATA=true

# Upstream Stratum. Keep development mode until the local simulator is running.
UPSTREAM_DRIVER=development
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=3334
UPSTREAM_TLS=false
UPSTREAM_SERVER_NAME=
UPSTREAM_USERNAME=upstream.account
UPSTREAM_PASSWORD=x
UPSTREAM_USER_AGENT=MiningPlatform/0.3.0-alpha.7
UPSTREAM_CONNECT_TIMEOUT_MS=5000
UPSTREAM_RESPONSE_TIMEOUT_MS=10000
UPSTREAM_MAXIMUM_ATTEMPTS=5
UPSTREAM_MAXIMUM_RECOVERY_CYCLES=5
UPSTREAM_RECONNECT_BASE_MS=250
UPSTREAM_RECONNECT_MAXIMUM_MS=30000
UPSTREAM_RECONNECT_JITTER_RATIO=0.2
UPSTREAM_SHARE_QUEUE_CAPACITY=256
UPSTREAM_SHARE_QUEUE_TIMEOUT_MS=10000
UPSTREAM_JOB_CACHE_MAXIMUM_ENTRIES=512
UPSTREAM_HEALTH_DRIVER=redis
UPSTREAM_HEALTH_KEY_PREFIX=mining:upstream-health:v1:
UPSTREAM_HEALTH_TTL_MS=86400000
UPSTREAM_HEALTH_PROBE_LEASE_MS=5000

# Multi-upstream JSON is required when UPSTREAM_DRIVER=multi. Single-pool tcp mode uses UPSTREAM_HOST/USERNAME/PASSWORD.
# Secrets shown below are placeholders; use a secret manager in production.
UPSTREAM_POOLS_JSON=
# Example single-line value:
# [{"id":"primary","name":"Primary Pool","host":"pool-a.example","port":443,"tls":true,"username":"account.worker","password":"replace-me","priority":10,"weight":100,"failureThreshold":3,"recoveryTimeoutMs":30000},{"id":"backup","name":"Backup Pool","host":"pool-b.example","port":3333,"tls":false,"username":"account.worker","password":"replace-me","priority":20,"weight":100,"failureThreshold":2,"recoveryTimeoutMs":60000}]

# Conservative VarDiff foundation. Disabled by default until pool policy is reviewed.
VARDIFF_ENABLED=false
VARDIFF_TARGET_SHARE_INTERVAL_SECONDS=15
VARDIFF_RETARGET_INTERVAL_SECONDS=90
VARDIFF_MINIMUM_DIFFICULTY=1
VARDIFF_MAXIMUM_DIFFICULTY=1000000000
VARDIFF_MAXIMUM_ADJUSTMENT_FACTOR=4
VARDIFF_MINIMUM_SAMPLES=4

# Local upstream simulator, no Docker required.
UPSTREAM_SIMULATOR_HOST=127.0.0.1
UPSTREAM_SIMULATOR_PORT=3334
UPSTREAM_SIMULATOR_DIFFICULTY=0.000001
UPSTREAM_SIMULATOR_REJECT_SHARES=false

# Native Bitcoin mining remains disabled in CI. Regtest uses a disposable test destination.
NATIVE_BITCOIN_MINING_ENABLED=false
BITCOIN_COINBASE_PAYOUT_NETWORK=mainnet
BITCOIN_COINBASE_PAYOUT_ADDRESS=1P6FZk2jiRuFkP8m4RuAVi9QVYWvhDCtrA

# Payout and Bitcoin RPC. Keep payouts disabled.
PAYOUTS_ENABLED=false
PAYOUT_SCHEDULE=0 2 * * *
MINIMUM_PAYOUT_BTC=0.001
PAYOUT_CONFIRMATIONS_BTC=3
BITCOIN_RPC_URL=http://bitcoin-node:8332
BITCOIN_RPC_USER=replace-me
BITCOIN_RPC_PASSWORD=replace-me
BITCOIN_WALLET_NAME=mining-platform-hot

# Object storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mining-platform
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true

# Monitoring
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Central scheduler retention
SCHEDULER_INTERVAL_MS=3600000
HASHRATE_BUCKET_RETENTION_DAYS=7
HASHRATE_SNAPSHOT_RETENTION_DAYS=90
OUTBOX_PUBLISHED_RETENTION_DAYS=7
IDEMPOTENCY_RETENTION_DAYS=30

# Build metadata (normally injected by CI/container builds)
MINING_BUILD_VERSION=0.3.0-alpha.7
GIT_COMMIT=UNCOMMITTED
BUILD_DATE=2026-08-22T00:00:00+07:00
SCHEMA_VERSION=13
SCHEMA_MIGRATION=20260822010000_payout_control_foundation

# CI-only feature gates
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=MiningPlatform <no-reply@example.test>
SUPPORT_PAYMENTS_ENABLED=false
