{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "REDIS_INTEGRATION_URL",
        "APP_URL",
        "NODE_ENV",
        "AUTH_JWT_SECRET",
        "AUTH_ENCRYPTION_KEY",
        "AUTH_IP_HASH_KEY",
        "AUTH_EXPOSE_TEST_TOKENS",
        "AUTH_SECURE_COOKIES",
        "STRATUM_IP_HASH_KEY",
        "STRATUM_DEV_MODE",
        "STRATUM_AUTH_DRIVER",
        "UPSTREAM_DRIVER",
        "EMAIL_PROVIDER"
      ]
    }
  }
}
