# MiningPlatform
# Author: Abia Nugrahanto
# Copyright (c) 2026 Abia Nugrahanto. All rights reserved.

# Copy to .env for local Docker development. Replace every change-me value.
NODE_ENV=development
APP_NAME=MiningPlatform
APP_URL=http://localhost
LOG_LEVEL=info
ENABLE_SWAGGER=true

# PostgreSQL
POSTGRES_DB=mining_platform
POSTGRES_USER=mining
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql://mining:change-me-postgres@postgres:5432/mining_platform?schema=public

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379
EVENT_BUS_DRIVER=redis
EVENT_STORE_DRIVER=postgres
EVENT_STREAM=mining:domain-events
MINING_EVENT_GROUP=mining-projection-v1
REALTIME_EVENT_GROUP=api-realtime-v1
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LOCK_TIMEOUT_MS=60000

# Development dashboard. It is forcibly disabled when NODE_ENV=production.
ENABLE_DEVELOPMENT_DASHBOARD=true
DEVELOPMENT_DASHBOARD_TOKEN=local-development-dashboard
DEVELOPMENT_WORKER_ID=dev-7d9a4df2e77952c0657de069
NEXT_PUBLIC_ENABLE_DEVELOPMENT_DASHBOARD=true
NEXT_PUBLIC_DEVELOPMENT_DASHBOARD_TOKEN=local-development-dashboard
NEXT_PUBLIC_DEVELOPMENT_WORKER_ID=dev-7d9a4df2e77952c0657de069

# Authentication placeholders. Authentication is not production-ready yet.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
TOTP_ISSUER=MiningPlatform

# Mining gateway
MINING_ASSET=BTC
MINING_ALGORITHM=SHA256
REWARD_METHOD=FOLLOW_UPSTREAM
PLATFORM_FEE_PERCENT=2
STRATUM_HOST=0.0.0.0
STRATUM_PORT=3333
STRATUM_DEV_MODE=true
STRATUM_DEV_WORKER=demo.worker1
STRATUM_DEV_PASSWORD=x
STRATUM_DEV_DIFFICULTY=0.000001
STRATUM_VERSION_ROLLING_MASK=1fffe000
STRATUM_SOCKET_TIMEOUT_MS=120000
STRATUM_MAX_LINE_BYTES=16384
STRATUM_MAX_SUBMISSIONS_PER_SECOND=20
STRATUM_DEV_DATA_DIR=/app/data/stratum
STRATUM_IP_HASH_KEY=replace-with-a-random-hmac-key-at-least-32-characters
SEED_DEVELOPMENT_DATA=true

# Upstream Stratum. Keep development mode until the local simulator is running.
UPSTREAM_DRIVER=development
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=3334
UPSTREAM_TLS=false
UPSTREAM_SERVER_NAME=
UPSTREAM_USERNAME=upstream.account
UPSTREAM_PASSWORD=x
UPSTREAM_USER_AGENT=MiningPlatform/0.2.0-alpha.4
UPSTREAM_CONNECT_TIMEOUT_MS=5000
UPSTREAM_RESPONSE_TIMEOUT_MS=10000
UPSTREAM_MAXIMUM_ATTEMPTS=5

# Local upstream simulator, no Docker required.
UPSTREAM_SIMULATOR_HOST=127.0.0.1
UPSTREAM_SIMULATOR_PORT=3334
UPSTREAM_SIMULATOR_DIFFICULTY=0.000001
UPSTREAM_SIMULATOR_REJECT_SHARES=false

# Payout and Bitcoin RPC. Keep payouts disabled.
PAYOUTS_ENABLED=false
PAYOUT_SCHEDULE=0 2 * * *
MINIMUM_PAYOUT_BTC=0.001
PAYOUT_CONFIRMATIONS_BTC=3
BITCOIN_RPC_URL=http://bitcoin-node:8332
BITCOIN_RPC_USER=replace-me
BITCOIN_RPC_PASSWORD=replace-me
BITCOIN_WALLET_NAME=mining-platform-hot

# Object storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mining-platform
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true

# Monitoring
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Central scheduler retention
SCHEDULER_INTERVAL_MS=3600000
HASHRATE_BUCKET_RETENTION_DAYS=7
HASHRATE_SNAPSHOT_RETENTION_DAYS=90
OUTBOX_PUBLISHED_RETENTION_DAYS=7
IDEMPOTENCY_RETENTION_DAYS=30
