# Runtime
NODE_ENV=development
APP_NAME=MiningPlatform
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL
POSTGRES_DB=mining_platform
POSTGRES_USER=mining
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://mining:change-me@postgres:5432/mining_platform?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
TOTP_ISSUER=MiningPlatform

# Owner access
OWNER_EMAIL=owner@example.com
OWNER_IP_ALLOWLIST=127.0.0.1,::1
OWNER_ROUTE_PREFIX=owner

# Mining gateway
MINING_ASSET=BTC
MINING_ALGORITHM=SHA256
REWARD_METHOD=FOLLOW_UPSTREAM
PLATFORM_FEE_PERCENT=2
STRATUM_HOST=0.0.0.0
STRATUM_PORT=3333
UPSTREAM_STRATUM_HOST=replace-with-upstream-host
UPSTREAM_STRATUM_PORT=3333
UPSTREAM_STRATUM_TLS=false
UPSTREAM_POOL_USERNAME=replace-with-platform-worker
UPSTREAM_POOL_PASSWORD=x

# Payout
PAYOUT_SCHEDULE=0 2 * * *
MINIMUM_PAYOUT_BTC=0.001
PAYOUT_CONFIRMATIONS_BTC=3
PAYOUTS_ENABLED=false

# Bitcoin RPC
BITCOIN_RPC_URL=http://bitcoin-node:8332
BITCOIN_RPC_USER=replace-me
BITCOIN_RPC_PASSWORD=replace-me
BITCOIN_WALLET_NAME=mining-platform-hot

# Object storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mining-platform
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
METRICS_ENABLED=true
LOG_LEVEL=info
