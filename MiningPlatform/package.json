{
  "name": "mining-platform",
  "version": "0.3.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "Mining Pool Management Platform monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm prepare:workspace && turbo dev --filter=@mining/web --filter=@mining/api --filter=@mining/stratum-server --filter=@mining/mining-worker --filter=@mining/outbox-worker --filter=@mining/scheduler",
    "build": "pnpm db:generate && turbo build",
    "lint": "turbo lint",
    "typecheck": "pnpm db:generate && pnpm typecheck:scripts && turbo typecheck",
    "test": "pnpm db:generate && turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @mining/database generate",
    "db:migrate": "pnpm --filter @mining/database migrate:dev",
    "db:seed": "pnpm --filter @mining/database seed",
    "db:studio": "pnpm --filter @mining/database studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "pnpm lint && pnpm typecheck",
    "smoke:stratum": "tsx scripts/stratum-smoke-client.ts",
    "db:migrate:deploy": "pnpm --filter @mining/database migrate:deploy",
    "prepare:workspace": "pnpm db:generate && pnpm build:packages",
    "build:packages": "turbo build --filter='./packages/*'",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "docker:up:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "docker:down:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "dev:upstream-simulator": "pnpm --filter @mining/upstream-simulator dev",
    "test:upstream": "pnpm --filter @mining/upstream-stratum test && pnpm --filter @mining/stratum-server test",
    "headers:author": "node scripts/add-author-headers.mjs",
    "worker:credential": "tsx scripts/worker-credential-cli.ts",
    "verify:alpha5:static": "node scripts/check-alpha5-upgrade.mjs",
    "verify:alpha5": "node scripts/verify-alpha5-release.mjs",
    "verify:alpha5:fast": "node scripts/verify-alpha5-release.mjs --skip-install --skip-build",
    "verify:migration:fresh": "node scripts/verify-v030-alpha1-migration.mjs fresh",
    "verify:migration:upgrade": "node scripts/verify-v030-alpha1-migration.mjs upgrade",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "release:manifest": "node scripts/generate-release-manifest.mjs . release-manifest.json",
    "release:manifest:verify": "node scripts/verify-release-manifest.mjs .",
    "verify:alpha6:static": "node scripts/check-alpha6-upgrade.mjs",
    "verify:alpha6": "node scripts/verify-alpha6-release.mjs",
    "test:upstream-resilience": "pnpm --filter @mining/upstream-stratum test && pnpm --filter @mining/stratum-server test",
    "verify:alpha6:fast": "node scripts/verify-alpha6-release.mjs --skip-install --skip-build",
    "verify:migration:alpha6:fresh": "node scripts/verify-alpha6-migration.mjs fresh",
    "verify:migration:alpha6:upgrade": "node scripts/verify-alpha6-migration.mjs upgrade",
    "verify:v030-alpha1:static": "node scripts/check-v030-alpha1.mjs",
    "verify:v030-alpha1": "node scripts/verify-v030-alpha1-release.mjs",
    "verify:v030-alpha1:fast": "node scripts/verify-v030-alpha1-release.mjs --static-only",
    "verify:migration:v030-alpha1:fresh": "node scripts/verify-v030-alpha1-migration.mjs fresh",
    "verify:migration:v030-alpha1:upgrade": "node scripts/verify-v030-alpha1-migration.mjs upgrade",
    "user:role": "tsx scripts/user-role-cli.ts",
    "verify:migration:v030-alpha2:fresh": "node scripts/verify-v030-alpha2-migration.mjs fresh",
    "verify:migration:v030-alpha2:upgrade": "node scripts/verify-v030-alpha2-migration.mjs upgrade",
    "test:integration:auth": "pnpm --filter @mining/api test",
    "verify:v030-alpha2:static": "node scripts/check-v030-alpha2.mjs",
    "db:snapshot": "node scripts/database-snapshot.mjs backup",
    "db:restore": "node scripts/database-snapshot.mjs restore",
    "verify:payment-addresses": "node scripts/validate-payment-addresses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.0.0",
    "eslint": "9.39.5",
    "prettier": "3.0.0",
    "tsx": "4.19.0",
    "turbo": "2.0.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.65.0"
  },
  "author": "Abia Nugrahanto"
}
